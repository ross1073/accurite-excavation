---
import SEOHead from '../components/SEOHead.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  schemaType?: 'home' | 'service' | 'location' | 'blog' | 'reviews' | 'page';
  schemaData?: Record<string, any>;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  hideBreadcrumbs?: boolean;
}

const {
  title,
  description,
  schemaType = 'page',
  schemaData = {},
  canonical,
  ogImage,
  ogType,
  noindex,
  hideBreadcrumbs = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5ZH4WRGC');</script>
    <!-- End Google Tag Manager -->
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <SchemaMarkup type={schemaType} data={schemaData} />
  </head>
  <body class="font-body text-charcoal bg-white min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5ZH4WRGC"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[60] focus:bg-white focus:text-charcoal focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg focus:font-semibold">Skip to content</a>
    <Header />
    {!hideBreadcrumbs && <Breadcrumbs />}
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <!-- Sticky mobile CTA -->
    <div class="fixed bottom-0 left-0 right-0 z-50 lg:hidden bg-gold-dark shadow-[0_-2px_8px_rgba(0,0,0,0.15)]">
      <a
        href="tel:+18018146975"
        data-ghl-phone
        class="flex items-center justify-center gap-2 py-3 text-white font-semibold text-base"
        data-source="sticky-cta"
        aria-label="Call AccuRite Excavation at (801) 814-6975"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
        Call (801) 814-6975
      </a>
    </div>
    <!-- Add bottom padding on mobile so sticky CTA doesn't overlap footer -->
    <div class="h-12 lg:hidden" aria-hidden="true"></div>
    <script src="/js/mobile-menu.js" defer></script>
    <script src="/js/form-tracking.js" defer></script>
  </body>
</html>
